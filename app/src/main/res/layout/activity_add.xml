<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:text="Add New Recipe"
            android:textColor="@color/button_lavender"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Recipe Title (Max 30 chars)*"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAddTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/card_bg"
            android:hint="e.g. Spaghetti Carbonara"
            android:inputType="textCapWords"
            android:maxLength="30"
            android:padding="12dp"
            android:textColor="@color/text_light"
            android:textColorHint="@color/hint_gray" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Keywords (Max 30 chars)"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAddKeywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/card_bg"
            android:hint="e.g. Italian, Pasta, Quick"
            android:inputType="text"
            android:maxLength="30"
            android:padding="12dp"
            android:textColor="@color/text_light"
            android:textColorHint="@color/hint_gray" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Steps &amp; Instructions (Max 300 chars)"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAddSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@color/card_bg"
            android:gravity="top|start"
            android:hint="Enter step-by-step cooking instructions..."
            android:inputType="textMultiLine"
            android:maxLength="300"
            android:minLines="5"
            android:padding="12dp"
            android:textColor="@color/text_light"
            android:textColorHint="@color/hint_gray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSaveRecipe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/button_lavender"
                android:text="Save Recipe"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCancelAdd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/button_lavender"
                android:text="Cancel"
                android:textColor="@color/black"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>